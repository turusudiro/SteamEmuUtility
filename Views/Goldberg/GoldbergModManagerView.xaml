<UserControl
    x:Class="SteamEmuUtility.Views.Goldberg.GoldbergModManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SteamEmuUtility.Controls"
    xmlns:cv="clr-namespace:ConvertersCommon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SteamEmuUtility.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SteamEmuUtility.ViewModels.Goldberg"
    d:DataContext="{d:DesignInstance vm:GoldbergModManagerViewModels,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <cv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="CenterDataGridHeader"
            BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"
            TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style BasedOn="{StaticResource SEU_ButtonStyle}" TargetType="Button" />
        <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="DataGrid" />
    </UserControl.Resources>
    <Grid Margin="20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid
            Margin="0,7"
            AutoGenerateColumns="False"
            CanUserResizeColumns="False"
            CanUserResizeRows="False"
            CellStyle="{StaticResource NoSelectionDataGridCell}"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding ModsView}"
            RowStyle="{StaticResource NoSelectionDataGridRow}"
            ScrollViewer.CanContentScroll="True"
            SelectionUnit="Cell"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="2*"
                    Binding="{Binding ID}"
                    Header="ID">
                    <DataGridTextColumn.ElementStyle>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="Margin" Value="5,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn
                    Width="4*"
                    Binding="{Binding Title}"
                    Header="{DynamicResource LOCNameLabel}">
                    <DataGridTextColumn.ElementStyle>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="Margin" Value="5,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Width="2*" Header="{DynamicResource LOCEnabledTitle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:GoldbergModViewModel">
                            <controls:IconText
                                HorizontalAlignment="Center"
                                FalseForeground="IndianRed"
                                FalseStyle="{StaticResource SEU_CloseCircleStyle}"
                                IsActive="{Binding IsEnabled}"
                                TrueForeground="LimeGreen"
                                TrueStyle="{StaticResource SEU_CheckCircleStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="2*">
                    <DataGridTemplateColumn.Header>
                        <TextBlock
                            Text="{DynamicResource LOCGameInstallationStatus}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:GoldbergModViewModel">
                            <controls:IconText
                                HorizontalAlignment="Center"
                                FalseForeground="IndianRed"
                                FalseStyle="{StaticResource SEU_CloseCircleStyle}"
                                IsActive="{Binding ModDirExists}"
                                TrueForeground="LimeGreen"
                                TrueStyle="{StaticResource SEU_CheckCircleStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:GoldbergModViewModel">
                            <DockPanel HorizontalAlignment="Right">
                                <Button
                                    Command="{Binding DataContext.AddToJsonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding InModsJson, Converter={cv:BooleanToVisibilityConverter}, ConverterParameter=True}">
                                    <controls:IconText IconStyle="{StaticResource SEU_PlusIconStyle}" Label="mods.json" />
                                </Button>
                                <DockPanel Visibility="{Binding InModsJson, Converter={cv:BooleanToVisibilityConverter}}">
                                    <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <controls:IconText IconStyle="{StaticResource SEU_MinusIconStyle}" Label="mods.json" />
                                    </Button>
                                    <Button
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{DynamicResource LOCEditGame}" />
                                </DockPanel>
                                <Button
                                    Command="{Binding DataContext.OpenModPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding ModPath}"
                                    Visibility="{Binding ModDirExists, Converter={cv:BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource SEU_FolderOpenIconStyle}" />
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding AddModCommand}">
                        <controls:IconText IconStyle="{StaticResource SEU_PlusIconStyle}" Label="Mod" />
                    </Button>
                    <Button
                        Command="{Binding OpenModDirCommand}"
                        Content="{DynamicResource LOCSEU_GBOpenModsDir}"
                        IsEnabled="{Binding CanExecuteOpenModDir}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Text="{DynamicResource LOCSEU_GBUsingModsJson}"
                    TextAlignment="Right"
                    Visibility="{Binding ModsJsonExists, Converter={cv:BooleanToVisibilityConverter}}" />

            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}">
                        <controls:IconText IconStyle="{StaticResource SEU_RefreshIconStyle}" Label="{DynamicResource LOCSEU_GBRefreshWorkshopMetadata}" />
                    </Button>
                    <Button Command="{Binding ScanCommand}" Content="{DynamicResource LOCSEU_GBScanInstalledWorkshop}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding ApplyCommand}"
                        Content="{DynamicResource LOCSaveLabel}"
                        Style="{StaticResource BottomButton}" />
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}"
                        Content="{DynamicResource LOCCancelLabel}"
                        Style="{StaticResource BottomButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
