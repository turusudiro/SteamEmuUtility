<UserControl
    x:Class="SteamEmuUtility.Views.Goldberg.GoldbergConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:ConvertersCommon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="830"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock" />
    </UserControl.Resources>
    <DockPanel Margin="20">
        <DockPanel>
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GamesCount}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock
                Margin="0,0,0,10"
                HorizontalAlignment="Center"
                DockPanel.Dock="Top"
                Text="{DynamicResource LOCSEU_ListGame}" />
            <ListBox
                x:Name="Game"
                Width="300"
                IsSynchronizedWithCurrentItem="True"
                ItemsSource="{Binding GoldbergGames}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Name}">
                            <TextBlock.ToolTip>
                                <ToolTip Content="{Binding Name}" />
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid DataContext="{Binding SelectedItem, ElementName=Game}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,0,10,10">
                    <TextBlock
                        Margin="0,2,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{DynamicResource LOCSEU_OverlayLabel}" />
                    <Separator Margin="0,5,0,5" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_OverlayEnable}"
                        IsChecked="{Binding ConfigsOverlay.EnableOverlay}"
                        ToolTip="{DynamicResource LOCSEU_OverlayEnableTooltip}" />
                    <CheckBox
                        Content="{DynamicResource LOCSEU_OverlayDisableAchievement}"
                        IsChecked="{Binding ConfigsOverlay.DisableOverlayAchievement}"
                        IsEnabled="{Binding ConfigsOverlay.EnableOverlay}"
                        ToolTip="{DynamicResource LOCSEU_OverlayDisableAchievementTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_OverlayDisableFriend}"
                        IsChecked="{Binding ConfigsOverlay.DisableOverlayFriend}"
                        IsEnabled="{Binding ConfigsOverlay.EnableOverlay}"
                        ToolTip="{DynamicResource LOCSEU_OverlayDisableFriendTooltip}" />
                    <TextBlock
                        Margin="2,2,0,2"
                        IsEnabled="{Binding ConfigsOverlay.EnableOverlay}"
                        Text="{DynamicResource LOCSEU_OverlayHookDelayInSec}" />
                    <TextBox
                        MaxHeight="20"
                        Margin="2,2,0,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding ConfigsOverlay.EnableOverlay}"
                        Text="{Binding ConfigsOverlay.DelayHookInSec, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource LOCSEU_OverlayHookDelayInSecTooltip}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,0,10,10">
                    <TextBlock
                        Margin="0,2,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{DynamicResource LOCSEU_NetworkingLabel}" />
                    <Separator Margin="0,5,0,5" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_CustomBroadcast}"
                        IsChecked="{Binding CustomBroadcast}"
                        ToolTip="{DynamicResource LOCSEU_CustomBroadcastTooltip}" />
                    <ScrollViewer Margin="0,2,0,2">
                        <TextBox
                            MaxHeight="35"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AcceptsReturn="True"
                            IsEnabled="{Binding CustomBroadcast}"
                            Text="{Binding CustomBroadcastAddress, UpdateSourceTrigger=PropertyChanged}"
                            VerticalScrollBarVisibility="Auto" />
                    </ScrollViewer>
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_DisableLANOnly}"
                        IsChecked="{Binding ConfigsMain.DisableLANOnly}"
                        ToolTip="{DynamicResource LOCSEU_DisableLANOnlyTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_DisableNetworking}"
                        IsChecked="{Binding ConfigsMain.DisableNetworking}"
                        ToolTip="{DynamicResource LOCSEU_DisableNetworkingTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_OfflineMode}"
                        IsChecked="{Binding ConfigsMain.OfflineModeSteam}"
                        ToolTip="{DynamicResource LOCSEU_OfflineModeTooltip}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="10,0,10,10">
                    <TextBlock
                        Margin="0,2,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{DynamicResource LOCSEU_OtherLabel}" />
                    <Separator Margin="0,5,0,5" />
                    <Button
                        Margin="0,2,0,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.OpenSettingsPath, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Content="{DynamicResource LOCSEU_OpenSettingsFolder}"
                        ToolTip="{DynamicResource LOCSEU_OpenSettingsFolderTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_PatchSteamStub}"
                        IsChecked="{Binding ConfigsColdClientLoader.PatchSteamStub}"
                        ToolTip="{DynamicResource LOCSEU_PatchSteamStubTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_RunAsAdmin}"
                        IsChecked="{Binding ConfigsEmu.RunAsAdmin}"
                        ToolTip="{DynamicResource LOCSEU_RunAsAdminTooltip}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,10">
                    <TextBlock
                        Margin="0,2,0,5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="{DynamicResource LOCSEU_Game}" />
                    <Separator Margin="0,5,0,5" />
                    <StackPanel>
                        <TextBlock Margin="2,2,0,2" Text="{DynamicResource LOCSEU_Branch}" />
                        <ComboBox
                            x:Name="Branch"
                            Margin="0,2,0,2"
                            IsEnabled="{Binding Branches, Converter={cv:ItemsSourceCountToEnabledConverter}}"
                            ItemsSource="{Binding Branches}"
                            SelectedItem="{Binding SelectedBranch}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding DataContext.UpdateBranch, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_UnlockSelectedDLC}"
                        IsChecked="{Binding ConfigsEmu.UnlockOnlySelectedDLC}"
                        IsEnabled="{Binding ConfigsApp.UnlockAll, Converter={cv:InverseBooleanConverter}}"
                        ToolTip="{DynamicResource LOCSEU_UnlockSelectedDLCTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Content="{DynamicResource LOCSEU_UnlockAllDLC}"
                        IsChecked="{Binding ConfigsApp.UnlockAll}"
                        ToolTip="{DynamicResource LOCSEU_UnlockAllDLCTooltip}" />
                    <CheckBox
                        Margin="0,2,0,2"
                        Command="{Binding DataContext.SetCloudSave, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Content="{DynamicResource LOCSEU_EnableCloudSave}"
                        IsChecked="{Binding EnableCloudSave}"
                        IsEnabled="{Binding IsCloudSaveAvailable}"
                        ToolTip="{DynamicResource LOCSEU_EnableCloudSaveTooltip}" />
                    <TextBlock Margin="2,2,0,2" Text="{DynamicResource LOCSEU_ExeCommandLine}" />
                    <TextBox
                        MaxHeight="20"
                        Margin="2,2,0,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Text="{Binding ConfigsColdClientLoader.ExeCommandLine, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <TextBlock
                            Margin="0,2,0,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Goldberg" />
                        <Separator Margin="0,5,0,5" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateAllInfo}"
                            IsChecked="{Binding GenerateAllInfo}"
                            ToolTip="{DynamicResource LOCSEU_GenerateAllInfoTooltip}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoAchievement}"
                            IsChecked="{Binding GenerateAchievements}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoAchievementTooltip}" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoArchitecture}"
                            IsChecked="{Binding GenerateArchitecture}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoArchitectureTooltip}" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoBranches}"
                            IsChecked="{Binding GenerateBranches}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoBranchesTooltip}" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoColdClient}"
                            IsChecked="{Binding GenerateColdClient}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoColdClientTooltip}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5,0,0,0">
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoController}"
                            IsChecked="{Binding GenerateController}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoControllerTooltip}" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoDepots}"
                            IsChecked="{Binding GenerateDepots}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoDepotsTooltip}" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoDLC}"
                            IsChecked="{Binding GenerateDLC}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoDLCTooltip}" />
                        <CheckBox
                            Margin="0,2,0,2"
                            Content="{DynamicResource LOCSEU_GenerateInfoSupportedLang}"
                            IsChecked="{Binding GenerateSupportedLanguages}"
                            ToolTip="{DynamicResource LOCSEU_GenerateInfoSupportedLangTooltip}" />
                    </StackPanel>
                    <Button
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.GenerateInfo, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type UserControl}}}"
                        CommandParameter="{Binding}"
                        Content="{DynamicResource LOCSEU_GenerateInfo}"
                        IsEnabled="{Binding GenerateInfo}" />
                </Grid>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
